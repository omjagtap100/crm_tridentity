{
    "name": "ecom-saas-backend",
    "version": "1.0.0",
    "description": "Production-ready multi-tenant eCommerce SaaS backend",
    "main": "src/server.js",
    "type": "module",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --forceExit",
        "test:ci": "npm run test",
        "test:phase1": "npm test && node scripts/phase1-smoke-test.mjs",
        "migrate": "npx sequelize-cli db:migrate",
        "migrate:local": "cross-env NODE_ENV=development npx sequelize-cli db:migrate",
        "migrate:azure": "cross-env NODE_ENV=production npx sequelize-cli db:migrate",
        "monitoring:up": "docker compose -f docker-compose.monitoring.yml up -d",
        "monitoring:down": "docker compose -f docker-compose.monitoring.yml down",
        "monitoring:verify": "node scripts/phase3-verify-monitoring.mjs",
        "sonar:up": "docker compose -f docker-compose.sonarqube.yml up -d",
        "sonar:down": "docker compose -f docker-compose.sonarqube.yml down",
        "sonar:scan": "npm run test:ci && npx @sonar/scan",
        "security:scan": "powershell -ExecutionPolicy Bypass -File scripts/phase4-security-scan.ps1",
        "migrate:undo": "npx sequelize-cli db:migrate:undo:all",
        "seed": "npx sequelize-cli db:seed:all",
        "seed:undo": "npx sequelize-cli db:seed:undo:all"
    },
    "engines": {
        "node": "20.x"
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@opentelemetry/auto-instrumentations-node": "^0.52.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.54.0",
        "@opentelemetry/sdk-node": "^0.54.0",
        "bcrypt": "^5.1.1",
        "cors": "^2.8.5",
        "cos-nodejs-sdk-v5": "^2.15.4",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-rate-limit": "^7.3.1",
        "helmet": "^7.1.0",
        "joi": "^17.13.3",
        "jsonwebtoken": "^9.0.2",
        "mime-types": "^3.0.2",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "mysql2": "^3.11.0",
        "node-cron": "^3.0.3",
        "prom-client": "^15.1.3",
        "sequelize": "^6.37.3",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^10.0.0"
    },
    "devDependencies": {
        "@sonar/scan": "^4.2.7",
        "@jest/globals": "^29.7.0",
        "jest": "^29.7.0",
        "jest-junit": "^16.0.0",
        "cross-env": "^7.0.3",
        "nodemon": "^3.1.4",
        "sequelize-cli": "^6.6.2",
        "supertest": "^7.0.0"
    },
    "overrides": {
        "fast-xml-parser": "4.5.4",
        "form-data": "2.5.4"
    }
}
