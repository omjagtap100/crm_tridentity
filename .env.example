NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecom_saas_db
DB_USERNAME=root
DB_PASSWORD=123123123

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_64_chars_minimum_here_please
JWT_REFRESH_SECRET=change_me_refresh_secret_64_chars_minimum_here_please
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=*

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Observability (Phase 1 — used in Monitoring stage later)
OTEL_ENABLED=true
OTEL_SERVICE_NAME=ecom-saas-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Phase 3 — JSON logs for ELK (when LOG_FORMAT=json)
LOG_FORMAT=json

# Azure (Phase 2 — set after terraform apply; App Service sets these automatically in cloud)
# DB_HOST=<mysql-server>.mysql.database.azure.com
# APPLICATIONINSIGHTS_CONNECTION_STRING=<from Azure Portal or terraform output>
